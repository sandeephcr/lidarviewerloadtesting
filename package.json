{
  "name": "lidarviewer-loadtesting",
  "version": "1.0.0",
  "description": "Automated load testing setup for LiDAR Viewer using k6",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "setup-test": "npm run install-k6 && npm run generate-tokens && npm run generate-access-tokens && npm start",
    "generate-tokens": "node generateTokens.js",
    "generate-access-tokens": "node generateAccessToken.js",
"start": "cross-env K6_WEB_DASHBOARD=true k6 run multi-user-test.js --env BASE_URL=https://testing.lidartechsolutions.com",
    "view-report": "npx http-server -p 8080 -c-1 -o",
    "install-k6": "node scripts/installK6.js",
    "package": "node createPackage.js"
  },
  "dependencies": {
    "node-forge": "^1.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "http-server": "^14.1.1"
  }
}
